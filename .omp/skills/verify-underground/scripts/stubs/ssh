# ssh: only ug-backup calls ssh, to probe the backup host; every destination answers (stand-in).
# The owner reaches the agent through Tern, which the stand-in does not have.
fault ssh
dest=
while (($#)); do
  if [[ $1 == -- ]]; then
    break
  elif [[ $1 == -[pioFlLRDEJSWbcem] ]]; then
    shift
  elif [[ $1 != -* ]]; then
    dest=$1
    break
  fi
  shift
done
fault ssh-backup
log_note "backup host $dest answers (stand-in)"
exit 0
