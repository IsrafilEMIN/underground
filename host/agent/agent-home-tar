#!/bin/bash
set -euo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: agent-home-tar\n' >&2
  exit 64
fi

home=@AGENT_HOME@

die() {
  printf 'agent-home-tar: %s\n' "$*" >&2
  exit 1
}

tmp=$(mktemp -d "$home/.ug-backup-tar.XXXXXX") || die "could not make a temporary folder in $home"
trap 'rm -rf -- "$tmp"' EXIT

db_files=()
if [[ -d $home/.omp/agent ]]; then
  while IFS= read -r -d '' db; do
    db_files+=("$db")
  done < <(find "$home/.omp/agent" \( -path "$home/.omp/agent/cache" -o -name 'models.db*' \) -prune -o -type f -name '*.db' -print0)
fi
if [[ -f $home/.omp/stats.db ]]; then
  db_files+=("$home/.omp/stats.db")
fi

args=(--no-xattrs
  --exclude ./.omp/agent/cache
  --exclude 'models.db*'
  --exclude node_modules)
copies=()
n=0
for db in ${db_files[@]+"${db_files[@]}"}; do
  rel=${db#"$home/"}
  /usr/bin/sqlite3 "$db" ".timeout 5000" ".backup '$tmp/c$n.db'" || die "could not copy the database $rel"
  args+=(--exclude "./$rel" --exclude "./$rel-wal" --exclude "./$rel-shm")
  args+=(-s "|^\\./c$n\\.db\$|./$rel|")
  copies+=(-C "$tmp" "./c$n.db")
  n=$((n + 1))
done

members=()
if [[ -d $home/.omp/agent ]]; then
  members+=(./.omp/agent)
fi
if [[ -d $home/scratch ]]; then
  members+=(./scratch)
fi

/usr/bin/tar -C "$home" -c "${args[@]}" ${members[@]+"${members[@]}"} ${copies[@]+"${copies[@]}"} ||
  die "tar failed with status $?, so this run stores no snapshot"
