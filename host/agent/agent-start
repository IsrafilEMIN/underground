#!/bin/bash
set -eo pipefail

TMPDIR=$(getconf DARWIN_USER_TEMP_DIR)
export HOME=@AGENT_HOME@ TMPDIR PATH=@ROOT@/code/bin:/usr/bin:/bin:/usr/sbin:/sbin
export OMP_AUTH_BROKER_URL=http://127.0.0.1:@USAGE_BROKER_PORT@ OMP_AUTH_BROKER_TOKEN=usage-only
export GIT_CONFIG_COUNT=3 GIT_CONFIG_KEY_0=credential.https://github.com.helper GIT_CONFIG_VALUE_0= GIT_CONFIG_KEY_1=credential.https://github.com.helper GIT_CONFIG_VALUE_1='!f() { t=$("@ROOT@/code/bin/gh-app-token") || exit 1; echo username=x-access-token; echo "password=$t"; }; f' GIT_CONFIG_KEY_2=core.hooksPath GIT_CONFIG_VALUE_2=/dev/null

root=@ROOT@
code=$root/code
agent=$HOME/.omp/agent

die() {
  printf 'agent-start: %s\n' "$*" >&2
  exit 1
}

[[ -r $root/gateway-token ]] || die "cannot read $root/gateway-token; the owner runs host/bin/ug-setup"
export UG_GATEWAY_TOKEN=$(<"$root/gateway-token")
[[ -n $UG_GATEWAY_TOKEN ]] || die "$root/gateway-token is empty; the owner runs host/bin/ug-setup"

omp_bin=$(readlink "$code/bin/omp") || die "no $code/bin/omp; the owner runs host/bin/ug-setup"

# The agent's ssh login has no desktop session, so macOS logs a failed text-checking service lookup to stderr many times a session.
# grep ignores SIGINT so that a Ctrl-C cannot close omp's stderr.
start_omp() {
  unset GIT_CONFIG_KEY_2 GIT_CONFIG_VALUE_2
  export GIT_CONFIG_COUNT=2
  { "$omp_bin" "$@" 2>&1 1>&3 3>&- | { trap '' INT; /usr/bin/grep --line-buffered -v -F 'dataFromCheckingString received error' >&2 || true; }; } 3>&1
  exit 0
}

for dir in "$HOME/.omp" "$agent"; do
  if [[ -L $dir || ( -e $dir && ! -d $dir ) ]]; then rm -f "$dir"; fi
  mkdir -p "$dir"
done

(
  names=()
  staged=()
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    names+=("$name")
    if [[ -e $root/config/$name ]]; then staged+=("$name"); fi
  done <"$code/config-names"
  rm -rf -- "${names[@]/#/$agent/}"
  if (( ${#staged[@]} > 0 )); then cp -cR -- "${staged[@]/#/$root/config/}" "$agent/"; fi
) &
copy_pid=$!

copied() {
  wait "$copy_pid" || die "the config copy failed, so no session starts"
}

if [[ -z ${UG_REPO:-} ]]; then
  mkdir -p "$HOME/scratch"
  cd "$HOME/scratch"
  copied
  start_omp "$@"
fi
[[ $UG_REPO =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "UG_REPO has a value that is not owner/name"

clone=$HOME/work/$UG_REPO
if [[ ! -d $clone/.git ]]; then
  rm -rf "$clone"
  mkdir -p "$clone"
  git -C "$clone" init -q
  git -C "$clone" remote add origin "https://github.com/$UG_REPO.git"
fi
cd "$clone"

busy() {
  git rev-parse -q --verify HEAD >/dev/null || die "the clone is busy with its first sync; start the session again in a moment"
  printf 'agent-start: another session start holds the clone of %s; this session starts from the main that the clone has\n' "$UG_REPO" >&2
  copied
  start_omp "$@"
}

sync_status=0
/usr/bin/lockf -k -t 3 .git/ug-sync.lock git fetch --quiet --no-tags origin || sync_status=$?
(( sync_status != 75 )) || busy "$@"
(( sync_status == 0 )) || {
  printf 'agent-start: git fetch origin for %s failed: is the GitHub App installed on it, and does GitHub answer?\n' "$UG_REPO" >&2
  exit 69
}
remote=$(git ls-remote --symref origin HEAD) || remote=
base=$(printf '%s\n' "$remote" | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]].*|\1|p')
[[ -n $base ]] || {
  printf 'agent-start: cannot read the default branch of %s from GitHub\n' "$UG_REPO" >&2
  exit 69
}

checkout_status=0
/usr/bin/lockf -k -t 3 .git/ug-sync.lock git checkout -q --detach "origin/$base" || checkout_status=$?
(( checkout_status != 75 )) || busy "$@"
(( checkout_status == 0 )) || exit "$checkout_status"
copied
start_omp "$@"
