#!/usr/bin/env bash
set -euo pipefail

self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  target=$(readlink "$self")
  [[ $target == /* ]] || target=$(dirname "$self")/$target
  self=$target
done
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$(dirname "$self")/../lib/ug.bash"
# shellcheck source=host/lib/services.bash disable=SC1091
source "$(dirname "$self")/../lib/services.bash"
# shellcheck source=host/lib/sources.bash disable=SC1091
source "$(dirname "$self")/../lib/sources.bash"

UG=$HOME/$(ug_fact owner_data)
agent=$(ug_fact agent_user)
port=$(ug_fact agent_sshd_port)
key=$UG/agent-ssh/id_ed25519
known_hosts=$UG/agent-ssh/known_hosts
sshd_config=/etc/ssh/sshd_config
re='^[A-Za-z0-9._=:/@+-]+$'

[[ -n $(find "$HOME" -maxdepth 0 -perm 700 2>/dev/null) ]] ||
  ug_die ug-agent "your home $HOME is not mode 700; the agent user could read it. Run: host/bin/ug-setup"

for arg in "$@"; do
  [[ $arg =~ $re ]] || ug_die ug-agent "refused argument $arg: only letters, digits and . _ = : / @ + - are allowed"
done

[[ -f $key && -f $known_hosts ]] || ug_die ug-agent "no agent key or known_hosts under $UG/agent-ssh; run: host/bin/ug-setup"

if launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
  ug_sshd_denies_agent "$sshd_config" "$key" ||
    ug_die ug-agent "system Remote Login is running, and the system sshd does not deny $agent; without that, the agent user could log in there outside the pin. Run host/bin/ug-setup, or turn Remote Login off."
fi

top=$(git rev-parse --show-toplevel 2>/dev/null) || top=
if [[ -n $top ]]; then
  slug=$(ug_repo_slug "$top") || ug_die ug-agent "$top has no GitHub origin, so the agent cannot clone it"
  [[ -z $slug ]] || export UG_REPO=$slug
fi

sources=$UG/sources
[[ -f $sources ]] ||
  ug_die ug-agent "no $sources; run: host/bin/ug-setup to create it"
unpack=$(ug_fact root)/code/bin/agent-unpack
ug_sync_sources "$sources" "$HOME" "$agent" "$unpack" ug-agent >/dev/null || exit 1

ug_port_answers 127.0.0.1 "$port" >/dev/null 2>&1 ||
  ug_die ug-agent "the agent sshd on 127.0.0.1:$port does not answer. Check it with: sudo launchctl print system/com.underground.agent-sshd. Run host/bin/ug-setup to load it again."

notices=
add_notice() { notices=${notices:+$notices$'\n'}$1; }
last=$(head -n 1 "$UG/backup/last" 2>/dev/null) || last=
if [[ ! $last =~ ^[0-9]+$ ]]; then
  add_notice "no good backup yet; read $UG/backup/backup.log"
else
  now=$(date +%s)
  if (( now - last > 172800 )); then
    add_notice "the last good backup is $(( (now - last) / 86400 )) days old; read $UG/backup/backup.log"
  fi
fi
export UG_NOTICES=$notices
exec ssh -tt -p "$port" -i "$key" -o IdentitiesOnly=yes -o UserKnownHostsFile="$known_hosts" -o StrictHostKeyChecking=yes -o LogLevel=ERROR -o SendEnv=UG_REPO -o SendEnv=UG_NOTICES "$agent@127.0.0.1" -- "$@"
