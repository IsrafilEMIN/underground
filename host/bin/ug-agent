#!/usr/bin/env bash
set -euo pipefail

self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
  target=$(readlink "$self")
  [[ $target == /* ]] || target=$(dirname "$self")/$target
  self=$target
done
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$(dirname "$self")/../lib/ug.bash"

UG=$HOME/$(ug_fact owner_data)
agent=$(ug_fact agent_user)
port=$(ug_fact agent_sshd_port)
key=$UG/agent-ssh/id_ed25519
known_hosts=$UG/agent-ssh/known_hosts
sshd_config=/etc/ssh/sshd_config
re='^[A-Za-z0-9._=:/@+-]+$'

[[ -n $(find "$HOME" -maxdepth 0 -perm 700 2>/dev/null) ]] ||
  ug_die ug-agent "your home $HOME is not mode 700; the agent user could read it. Run: host/bin/ug-setup"

for arg in "$@"; do
  [[ $arg =~ $re ]] || ug_die ug-agent "refused argument $arg: only letters, digits and . _ = : / @ + - are allowed"
done

[[ -f $key && -f $known_hosts ]] || ug_die ug-agent "no agent key or known_hosts under $UG/agent-ssh; run: host/bin/ug-setup"

if launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
  ug_sshd_denies_agent "$sshd_config" "$key" ||
    ug_die ug-agent "system Remote Login is running, and the system sshd does not deny $agent; without that, the agent user could log in there outside the pin. Run host/bin/ug-setup, or turn Remote Login off."
fi

top=$(git rev-parse --show-toplevel 2>/dev/null) || top=
if [[ -n $top ]]; then
  slug=$(ug_repo_slug "$top") || ug_die ug-agent "$top has no GitHub origin, so the agent cannot clone it"
  [[ -z $slug ]] || export UG_REPO=$slug
fi

sources=$UG/sources
if [[ -f $sources ]]; then
  unpack=$(ug_fact root)/code/bin/agent-unpack
  target_re='^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$'
  paths=() targets=()
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -n $line && $line != '#'* ]] || continue
    read -r path target extra <<<"$line"
    [[ -n $path ]] || continue
    [[ -n $target && -z $extra ]] ||
      ug_die ug-agent "in $sources: \"$line\": a source is a repo path and a target, and nothing else"
    case $path in
      '~') path=$HOME ;;
      '~/'*) path=$HOME/${path#\~/} ;;
    esac
    [[ $path == /* ]] || ug_die ug-agent "in $sources: $path is not an absolute path or a ~ path"
    [[ $target =~ $target_re ]] ||
      ug_die ug-agent "in $sources: target $target is not a plain relative path"
    case /$target/ in
      */./*|*/../*) ug_die ug-agent "in $sources: target $target has a . or .. component" ;;
    esac
    for (( n=0; n<${#targets[@]}; n++ )); do
      prev=${targets[n]}
      [[ $target != "$prev" ]] || ug_die ug-agent "in $sources: two sources share the target $target"
      case $target in
        "$prev"/*) ug_die ug-agent "in $sources: target $target lies inside $prev" ;;
      esac
      case $prev in
        "$target"/*) ug_die ug-agent "in $sources: target $prev lies inside $target" ;;
      esac
    done
    paths+=("$path") targets+=("$target")
  done <"$sources"
  for (( n=0; n<${#paths[@]}; n++ )); do
    git -C "${paths[n]}" archive --format=tar HEAD |
      sudo -n -u "$agent" "$unpack" "${targets[n]}" ||
      ug_die ug-agent "cannot sync ${paths[n]} to $agent:${targets[n]}; is it a git repository with a HEAD commit, and did host/bin/ug-setup grant the unpack helper?"
  done
else
  ug_say ok sources "no $sources, so nothing is synced into $agent's home; write it to share config with $agent"
fi

ug_port_answers 127.0.0.1 "$port" >/dev/null 2>&1 ||
  ug_die ug-agent "the agent sshd on 127.0.0.1:$port does not answer. Check it with: sudo launchctl print system/com.underground.agent-sshd. Run host/bin/ug-setup to load it again."

exec ssh -tt -p "$port" -i "$key" -o IdentitiesOnly=yes -o UserKnownHostsFile="$known_hosts" -o StrictHostKeyChecking=yes -o LogLevel=ERROR -o SendEnv=UG_REPO "$agent@127.0.0.1" -- "$@"
