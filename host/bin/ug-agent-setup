#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: sudo host/bin/ug-agent-setup\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
# shellcheck source=host/lib/downloads.bash disable=SC1091
source "$src/host/lib/downloads.bash"
# shellcheck source=host/lib/services.bash disable=SC1091
source "$src/host/lib/services.bash"
# shellcheck source=host/lib/github.bash disable=SC1091
source "$src/host/lib/github.bash"

ug_as() {
  local login=$1
  shift
  if [[ $login == "$(id -un)" ]]; then
    "$@"
  else
    sudo -n -u "$login" -H "$@"
  fi
}

ug_read_as() {
  ug_as "$1" /bin/cat -- "$2"
}

# shellcheck disable=SC2016
ug_write_as() {
  ug_as "$1" /bin/sh -c 'umask 077 && /bin/cat >"$1" && /bin/chmod 600 "$1"' sh "$2"
}

ug_user_walls() {
  local owner_home=$1 key keys login other target home open=0
  local -a targets
  keys=$(sed -n 's/^\([a-z_]*\)_user=.*/\1/p' "$ug_facts_file")
  for key in $keys; do
    login=$(ug_fact "${key}_user") || return 1
    if ! ug_as "$login" /usr/bin/true >/dev/null 2>&1; then
      printf '%s: sudo cannot run as this user, so its walls are unproven\n' "$login"
      open=1
      continue
    fi
    targets=("$owner_home")
    for other in $keys; do
      if [[ $other != "$key" ]]; then
        home=$(ug_fact "${other}_home") || return 1
        targets+=("$home")
      fi
    done
    for target in "${targets[@]}"; do
      if ug_as "$login" /bin/ls "$target" >/dev/null 2>&1; then
        printf '%s can list %s, not its own home\n' "$login" "$target"
        open=1
      fi
    done
  done
  return "$open"
}

ug_service_login() {
  if [[ $1 == root ]]; then printf 'root\n'; else ug_fact "$1"; fi
}

ug_ensure_owner_mode() {
  local file=$1 owner=$2 mode=$3
  [[ $(stat -f '%Su:%Sg %Mp%Lp' "$file") != "$owner $mode" ]] || return 0
  chown "$owner" "$file" && chmod "$mode" "$file" || return 1
  [[ $(stat -f '%Su:%Sg %Mp%Lp' "$file") == "$owner $mode" ]]
}

trap 'ug_stopped $? $LINENO "$BASH_COMMAND" ug-agent-setup host/bin/ug-agent-setup ", so the agent user may be set up only in part" ", which repeats every step"' ERR

[[ $(id -u) -eq 0 ]] || ug_die ug-agent-setup "run it as root: sudo host/bin/ug-agent-setup"
owner=${SUDO_USER:-}
[[ -n $owner && $owner != root ]] || ug_die ug-agent-setup "SUDO_USER is not set; run it with sudo from your own login"
owner_home=/Users/$owner
ug_home=$owner_home
[[ -d $owner_home && ! -L $owner_home ]] || ug_die ug-agent-setup "$owner_home is not a folder"

ug_check_checkout "$src" ug-agent-setup || exit 1

root=$(ug_fact root)
code=$root/code
data=$owner_home/$(ug_fact owner_data)
agent_user=$(ug_fact agent_user)
agent_home=$(ug_fact agent_home)
auth_user=$(ug_fact auth_user)
auth_home=$(ug_fact auth_home)
tern_port=$(ug_fact agent_tern_port)
ip_port='^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$'
omp_pin=$(ug_pin_checked "$src/VERSIONS" omp '^[0-9A-Za-z.+-]+$' ug-agent-setup)
omp_sha=$(ug_pin_checked "$src/VERSIONS" omp_sha256 '^[0-9a-f]{64}$' ug-agent-setup)
omp_release=$(ug_pin_checked "$src/VERSIONS" omp_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$' ug-agent-setup)
gh_pin=$(ug_pin_checked "$src/VERSIONS" gh '^[0-9A-Za-z.+-]+$' ug-agent-setup)
gh_zip_sha=$(ug_pin_checked "$src/VERSIONS" gh_zip_sha256 '^[0-9a-f]{64}$' ug-agent-setup)
gh_release=$(ug_pin_checked "$src/VERSIONS" gh_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$' ug-agent-setup)
tern_app=$(ug_pin_checked "$src/VERSIONS" tern_app '^/Applications/[A-Za-z0-9 ._-]+\.app$' ug-agent-setup)
tern_team=$(ug_pin_checked "$src/VERSIONS" tern_team '^[A-Z0-9]{10}$' ug-agent-setup)

cleanup=()
trap '[[ ${#cleanup[@]} -eq 0 ]] || rm -rf "${cleanup[@]}"' EXIT

ug_step "agent users"
chmod 700 "$owner_home"
[[ -n $(find "$owner_home" -maxdepth 0 -perm 700 2>/dev/null) ]] || ug_die ug-agent-setup "$owner_home does not stay mode 700; nothing else set up"
ug_say ok "owner home" "mode 700"

next_uid() {
  local uid
  uid=$(dscl . -list /Users UniqueID | sed -n 's/.* //p' | sort -n | tail -1) || true
  uid=${uid:-0}
  printf '%s\n' $(( uid < 400 ? 400 : uid + 1 ))
}

make_user() {
  local name=$1 real=$2 shell=$3 home=$4 uid pw out
  if dscl . -read "/Users/$name" UniqueID >/dev/null 2>&1; then
    ug_say same "user $name" "exists"
  else
    uid=$(next_uid)
    pw=$(openssl rand -hex 24)
    dscl . -create "/Users/$name"
    dscl . -create "/Users/$name" UniqueID "$uid"
    dscl . -create "/Users/$name" PrimaryGroupID 20
    dscl . -create "/Users/$name" RealName "$real"
    dscl . -create "/Users/$name" NFSHomeDirectory "$home"
    out=$(printf 'passwd /Users/%s %s\n' "$name" "$pw" | dscl . 2>&1)
    unset pw
    [[ $out != *Error* && $out != *Invalid* ]] || ug_die ug-agent-setup "dscl cannot set a password for $name: ${out//$'\n'/; }"
    ug_say changed "user $name" "created, uid $uid"
  fi
  dscl . -create "/Users/$name" UserShell "$shell"
  dscl . -create "/Users/$name" IsHidden 1
  [[ " $(dscl . -read /Groups/admin GroupMembership 2>/dev/null) " != *" $name "* ]] ||
    ug_die ug-agent-setup "$name is in group admin; remove it: sudo dseditgroup -o edit -d $name -t user admin"
  install -d -m 700 -o "$name" -g staff "$home"
  ug_say ok "user $name" "standard, hidden, shell $shell, home mode 700"
}

make_user "$agent_user" "Underground agent" /bin/zsh "$agent_home"
make_user "$auth_user" "Underground logins" /usr/bin/false "$auth_home"

ug_step "agent tools"
omp_dir=$root/omp/$omp_pin
omp_bin=$omp_dir/omp
install -d -m 755 -o root -g wheel "$root" "$root/omp" "$omp_dir"
ug_fetch_pinned "$omp_release/v$omp_pin/omp-darwin-arm64" "$omp_sha" "$omp_bin" ug-agent-setup || exit 1
ug_ensure_owner_mode "$omp_bin" root:wheel 0555 || ug_die ug-agent-setup "cannot make $omp_bin root:wheel 0555; the agent could change it"
for old in "$root"/omp/*; do
  [[ $old == "$omp_dir" ]] || rm -rf "$old"
done
ug_say ok "omp" "$omp_pin installed, old versions removed"

gh_dir=$root/gh/$gh_pin
gh_bin=$gh_dir/gh
gh_zip=$gh_dir/gh.zip
install -d -m 755 -o root -g wheel "$root/gh" "$gh_dir"
ug_fetch_pinned "$gh_release/v$gh_pin/gh_${gh_pin}_macOS_arm64.zip" "$gh_zip_sha" "$gh_zip" ug-agent-setup || exit 1
gh_tmp=$(mktemp "$gh_dir/.gh.XXXXXX")
cleanup+=("$gh_tmp")
unzip -p "$gh_zip" "gh_${gh_pin}_macOS_arm64/bin/gh" >"$gh_tmp" || ug_die ug-agent-setup "cannot unzip $gh_zip; nothing changed"
chown root:wheel "$gh_tmp"
chmod 555 "$gh_tmp"
mv -f "$gh_tmp" "$gh_bin"
for old in "$root"/gh/*; do
  [[ $old == "$gh_dir" ]] || rm -rf "$old"
done
ug_say ok "gh" "$gh_pin installed, old versions removed"

[[ -d $tern_app ]] || ug_die ug-agent-setup "no $tern_app; install Tern.app into /Applications, then run host/bin/ug-setup"
tern_req="anchor apple generic and certificate leaf[subject.OU] = \"$tern_team\""
codesign --verify --strict -R="$tern_req" "$tern_app" 2>/dev/null ||
  ug_die ug-agent-setup "$tern_app does not carry a valid signature of team $tern_team; install Tern.app again, then run host/bin/ug-setup"
tern_ver=$( (cd / && ug_as "$agent_user" "$tern_app/Contents/MacOS/tern" --version) 2>/dev/null) || tern_ver=""
tern_ver=$(sed -n 's/^tern \([0-9A-Za-z.+-]*\) (\([0-9a-f]*\))$/\1-\2/p' <<<"$tern_ver")
[[ $tern_ver =~ ^[0-9A-Za-z.+-]+$ ]] || ug_die ug-agent-setup "$tern_app/Contents/MacOS/tern --version does not print tern <version> (<commit>)"
# A lone copy of the tern binary fails codesign and macOS kills it, so the whole signed bundle is copied.
tern_dir=$root/tern/$tern_ver
tern_bundle=$tern_dir/Tern.app
tern_bin=$tern_bundle/Contents/MacOS/tern
install -d -m 755 -o root -g wheel "$root/tern"
if ! codesign --verify --strict -R="$tern_req" "$tern_bundle" 2>/dev/null; then
  rm -rf "$tern_dir"
  install -d -m 755 -o root -g wheel "$tern_dir"
  tern_tmp=$(mktemp -d "$tern_dir/.Tern.XXXXXX")
  cleanup+=("$tern_tmp")
  ditto "$tern_app" "$tern_tmp/Tern.app"
  chown -R root:wheel "$tern_tmp/Tern.app"
  chmod -R a-w "$tern_tmp/Tern.app"
  codesign --verify --strict -R="$tern_req" "$tern_tmp/Tern.app" 2>/dev/null ||
    ug_die ug-agent-setup "the copy of $tern_app in $tern_tmp fails its signature check; nothing changed"
  mv "$tern_tmp/Tern.app" "$tern_bundle"
fi
for old in "$root"/tern/*; do
  [[ $old == "$tern_dir" ]] || rm -rf "$old"
done
ug_say ok "tern" "$tern_ver copied from $tern_app, old versions removed"

rendered_dir=$(mktemp -d)
cleanup+=("$rendered_dir")

render() {
  local template=$1 out
  shift
  out=$(ug_render "$rendered_dir/${template##*/}" "$src/$template" "$template" "$@") || ug_die ug-agent-setup "$out"
}

install -d -m 711 -o root -g wheel "$root/logs"

ug_step "agent login"
gh_app_dir=$root/github-app
install -d -m 500 -o "$agent_user" -g staff "$gh_app_dir"
ug_ensure_owner_mode "$gh_app_dir" "$agent_user:staff" 0500 ||
  ug_die ug-agent-setup "cannot make $gh_app_dir $agent_user mode 0500"
for name in github-app.json github-app.pem; do
  if [[ -e $data/$name || -L $data/$name ]]; then
    [[ -f $data/$name && ! -L $data/$name && $(stat -f '%l %Su' "$data/$name") == "1 $owner" ]] ||
      ug_die ug-agent-setup "$data/$name must be a plain file of $owner with one link; write it again"
    install -m 400 -o "$agent_user" -g staff "$data/$name" "$gh_app_dir/$name"
    rm -f "$data/$name"
    ug_say changed "github app" "moved $name into $gh_app_dir"
  elif [[ -e $gh_app_dir/$name ]]; then
    ug_ensure_owner_mode "$gh_app_dir/$name" "$agent_user:staff" 0400 ||
      ug_die ug-agent-setup "cannot make $gh_app_dir/$name $agent_user mode 0400"
  fi
done
if [[ ! -f $gh_app_dir/github-app.json || ! -f $gh_app_dir/github-app.pem ]]; then
  ug_say warn "github app" "no key yet; put the app key in $data/github-app.pem and {\"client_id\":\"<id>\",\"installation_id\":<n>} in $data/github-app.json, then run host/bin/ug-setup"
fi

tern_state=$root/tern-remote
install -d -m 700 -o "$agent_user" -g staff "$tern_state"
ug_ensure_owner_mode "$tern_state" "$agent_user:staff" 0700 ||
  ug_die ug-agent-setup "cannot make $tern_state $agent_user mode 0700"
install -d -m 755 -o "$owner" -g staff "$root/status"
ug_ensure_owner_mode "$root/status" "$owner:staff" 0755 ||
  ug_die ug-agent-setup "cannot make $root/status $owner mode 0755"

deny=/etc/ssh/sshd_config.d/010-underground-deny-ugagent.conf
deny_dir=$(mktemp -d)
cleanup+=("$deny_dir")
printf 'DenyUsers %s\n' "$agent_user" >"$deny_dir/deny"
install -m 444 -o root -g wheel "$deny_dir/deny" "$deny"
ssh-keygen -q -t ed25519 -N '' -f "$deny_dir/host_key"
ug_sshd_denies_agent /etc/ssh/sshd_config "$deny_dir/host_key" ||
  ug_die ug-agent-setup "system sshd does not deny $agent_user despite $deny; keep Remote Login off"
ug_say ok "system sshd" "denies $agent_user"

[[ -d $data ]] || ug_die ug-agent-setup "$data is missing; run host/bin/ug-setup first"

ug_step "agent code"
engine=$(sed -n 's/^engine=//p' "$data/addresses" 2>/dev/null) || true
[[ $engine =~ $ip_port ]] || ug_die ug-agent-setup "$data/addresses needs an engine=<ip>:<port> line"

for name in agent-start agent-env agent-dream agent-home-tar agent-unpack agent-pf.conf agent-pf-load; do
  render "host/agent/$name"
done
render "host/agent/agent-tern" -e "s|@TERN@|$tern_bin|g"
render "host/agent/zsh/zshenv"
render "host/agent/zsh/zshrc"
render "host/agent/gh-app-token"
render "host/agent/gh" -e "s|@GH@|$gh_bin|g"
pfctl -n -f "$rendered_dir/agent-pf.conf" >/dev/null 2>&1 || ug_die ug-agent-setup "pfctl rejects host/agent/agent-pf.conf; installed code unchanged"
rm -rf "$code.new" "$code.old"
install -d -m 755 -o root -g wheel "$code.new" "$code.new/bin" "$code.new/session-bin" "$code.new/zsh" "$code.new/usage-broker" "$code.new/authorized_keys"
ln -s "$omp_bin" "$code.new/bin/omp"
ln -s "$tern_bin" "$code.new/bin/tern"
ln -s "$code/agent-start" "$code.new/session-bin/omp"
install -m 555 -o root -g wheel "$rendered_dir/gh-app-token" "$rendered_dir/gh" "$code.new/bin/"
install -m 555 -o root -g wheel "$rendered_dir/agent-home-tar" "$rendered_dir/agent-unpack" "$src/host/agent/agent-check" "$code.new/bin/"
install -m 444 -o root -g wheel "$src"/host/usage-broker/*.ts "$code.new/usage-broker/"
install -m 444 -o root -g wheel "$src/host/facts" "$code.new/"
install -m 444 -o root -g wheel "$src/host/agent/ug-notices.ts" "$src/host/agent/dream-prompt.md" "$rendered_dir/agent-env" "$code.new/"
install -m 444 -o root -g wheel "$src/host/requirements" "$code.new/requirements"
install -m 444 -o root -g wheel "$rendered_dir/agent-pf.conf" "$code.new/pf.conf"
install -m 555 -o root -g wheel "$rendered_dir/agent-pf-load" "$code.new/pf-load"
install -m 555 -o root -g wheel "$rendered_dir/agent-start" "$rendered_dir/agent-dream" "$rendered_dir/agent-tern" "$code.new/"
install -m 444 -o root -g wheel "$rendered_dir/zshenv" "$code.new/zsh/.zshenv"
install -m 444 -o root -g wheel "$src/host/agent/zsh/zprofile" "$code.new/zsh/.zprofile"
install -m 444 -o root -g wheel "$rendered_dir/zshrc" "$code.new/zsh/.zshrc"
tern_keys=$code.new/authorized_keys/$agent_user
: >"$tern_keys"
for pub in "$owner_home"/.ssh/id_*.pub "$src/host/tern-keys"; do
  [[ -f $pub && ! -L $pub ]] || continue
  awk '$1 == "ssh-ed25519" || $1 == "ssh-rsa" || $1 ~ /^ecdsa-sha2-nistp(256|384|521)$/ { print $1, $2 }' "$pub" >>"$tern_keys"
done
chown -hR root:wheel "$code.new"
chmod 444 "$tern_keys"
tern_key_count=$(wc -l <"$tern_keys" | tr -d ' ')
[[ ! -e $code ]] || mv "$code" "$code.old"
mv "$code.new" "$code"
rm -rf "$code.old"
ug_say ok "agent code" "rebuilt in $code"
if [[ $tern_key_count -eq 0 ]]; then
  ug_say warn "tern keys" "no ed25519, ecdsa or rsa key in $owner_home/.ssh/id_*.pub, so Tern cannot log in as $agent_user; run: ssh-keygen -t ed25519, then host/bin/ug-setup"
else
  ug_say ok "tern keys" "$tern_key_count keys from $owner_home/.ssh and host/tern-keys in $code/authorized_keys/$agent_user"
fi

sudoers_tmp=$(mktemp) || ug_die ug-agent-setup "cannot make a temp file for the sudoers rules"
cleanup+=("$sudoers_tmp")
printf '%s ALL=(%s) NOPASSWD: %s, %s, %s\n' "$owner" "$agent_user" "$code/bin/agent-home-tar" "$code/bin/agent-unpack" "$code/bin/agent-check" >"$sudoers_tmp"
visudo -cf "$sudoers_tmp" >/dev/null || ug_die ug-agent-setup "visudo rejects the sudoers rules for the agent helpers; nothing installed"
install -m 440 -o root -g wheel "$sudoers_tmp" /etc/sudoers.d/underground
ug_say ok "sudoers" "$owner may run the agent helpers as $agent_user"

app_repos=$data/app-repos
app_tmp=$(mktemp "$data/.app-repos.XXXXXX") || ug_die ug-agent-setup "cannot make a temp file for $app_repos"
cleanup+=("$app_tmp")
if app_list=$( (cd / && ug_as "$agent_user" "$code/bin/gh" api installation/repositories --paginate --jq '.repositories[] | "\(.full_name) \(.private)"') 2>/dev/null); then
  [[ -z $app_list ]] || printf '%s\n' "$app_list" >"$app_tmp"
  chown "$owner:staff" "$app_tmp"
  chmod 600 "$app_tmp"
  mv -f "$app_tmp" "$app_repos"
  ug_say ok "app repos" "listed in $app_repos"
else
  ug_say warn "app repos" "cannot list them (no app key, or GitHub does not answer); kept $app_repos"
fi

ug_step "gateway"
ug_as "$auth_user" install -d -m 700 "$auth_home/.omp"
if ! ug_as "$auth_user" /bin/test -s "$auth_home/.omp/auth-gateway.token"; then
  openssl rand -hex 32 | ug_write_as "$auth_user" "$auth_home/.omp/auth-gateway.token"
  ug_say changed "gateway bearer" "new token for $auth_user"
fi
gateway_token=$(ug_read_as "$auth_user" "$auth_home/.omp/auth-gateway.token" 2>/dev/null | tr -d '[:space:]') || gateway_token=""
[[ $gateway_token =~ ^[A-Za-z0-9._~+=-]{12,}$ ]] || ug_die ug-agent-setup "$auth_home/.omp/auth-gateway.token is missing or holds invalid characters"
token_tmp=$(mktemp "$root/.gateway-token.XXXXXX")
cleanup+=("$token_tmp")
printf '%s\n' "$gateway_token" >"$token_tmp"
chown "$agent_user:staff" "$token_tmp"
chmod 400 "$token_tmp"
mv -f "$token_tmp" "$root/gateway-token"
ug_say ok "agent bearer" "$root/gateway-token, $agent_user mode 0400"

ug_step "daemons"

# shellcheck disable=SC2154
start_services() {
  local label name scope user template health log watch rendered out file want key logline kind
  while IFS='|' read -r label name scope user template health log watch; do
    render "$template" -e "s|@OMP@|$omp_bin|g" -e "s|@ENGINE@|$engine|g"
    rendered=$rendered_dir/${template##*/}
    want=$(ug_service_login "$user") || ug_die ug-agent-setup "service table gives $label user $user, not root or a key of host/facts"
    for key in StandardOutPath StandardErrorPath; do
      file=$(plutil -extract "$key" raw -o - "$rendered" 2>/dev/null) || continue
      [[ -e $file ]] || install -m 600 -o "$want" /dev/null "$file"
    done
    ug_service_probe daemon "$label" "$health" || ug_die ug-agent-setup "cannot check $label; nothing changed for it"
    logline=""
    [[ -z $log ]] || logline="; read $(ug_service_expand "$log")"
    watch=$(ug_service_expand "$watch") || ug_die ug-agent-setup "cannot expand the code paths of $label"
    out=$(ug_ensure_service system "$label" "$rendered" "/Library/LaunchDaemons/$label.plist" "$watch" "${ug_probe[@]}") ||
      ug_die ug-agent-setup "$label: $out; check it with: $ug_probe_hint$logline"
    kind=changed
    [[ $out != unchanged* ]] || kind=same
    ug_say "$kind" "$name" "$out"
  done < <(ug_services daemon)
}

retire_daemons() {
  local plist label err keep
  keep=$(ug_services daemon | cut -d '|' -f 1)
  for plist in /Library/LaunchDaemons/com.underground.*.plist; do
    [[ -e $plist || -L $plist ]] || continue
    label=${plist##*/}
    label=${label%.plist}
    grep -qxF "$label" <<<"$keep" && continue
    err=$(ug_stop_service "system/$label") || ug_die ug-agent-setup "$err"
    rm -f "$plist"
    ug_say changed "service $label" "removed; no longer used"
  done
}

walls=$(ug_user_walls "$owner_home") || ug_die ug-agent-setup "a wall between users is open: ${walls//$'\n'/; }; no service loaded"
ug_say ok "walls" "$agent_user and $auth_user cannot read your home or each other's"
retire_daemons
start_services

ug_step "tern host"
tern_key=$( (cd / && ug_as "$agent_user" "$code/bin/tern" remote host-key --state-dir "$tern_state") 2>&1) ||
  ug_die ug-agent-setup "tern remote host-key failed: ${tern_key//$'\n'/; }"
tern_fp=$(sed -n 's/.*"fingerprint":"\(SHA256:[A-Za-z0-9+/=]*\)".*/\1/p' <<<"$tern_key")
[[ -n $tern_fp ]] || ug_die ug-agent-setup "tern remote host-key printed no fingerprint: ${tern_key//$'\n'/; }"
tern_host_tmp=$(mktemp "$data/.tern-host.XXXXXX") || ug_die ug-agent-setup "cannot make a temp file for $data/tern-host"
cleanup+=("$tern_host_tmp")
printf '127.0.0.1:%s %s\n' "$tern_port" "$tern_fp" >"$tern_host_tmp"
chown "$owner:staff" "$tern_host_tmp"
chmod 600 "$tern_host_tmp"
mv -f "$tern_host_tmp" "$data/tern-host"
ug_say ok "tern host" "127.0.0.1:$tern_port $tern_fp in $data/tern-host"

ug_step "leftovers"
for item in "$root"/* "$root"/.[!.]*; do
  [[ -e $item || -L $item ]] || continue
  case ${item##*/} in
    omp | gh | tern | code | github-app | logs | gateway-token | tern-remote | status) ;;
    *)
      rm -rf "$item"
      ug_say changed "${item##*/}" "deleted from $root; no longer used"
      ;;
  esac
done

ug_step "checks"
gateway_port=$(ug_fact gateway_port)
usage_broker_port=$(ug_fact usage_broker_port)

agent_http() {
  local url=$1 out
  out=$( (cd / && ug_as "$agent_user" curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$url") 2>/dev/null ) || true
  printf '%s\n' "${out:-no answer}"
}

models_url=http://127.0.0.1:${gateway_port}/v1/models
models_noauth=$(agent_http "$models_url")
[[ $models_noauth == 401 ]] ||
  ug_die ug-agent-setup "$models_url answered $models_noauth without a bearer, not 401; anything on port $gateway_port could call the models"
models=$( (cd / && printf 'header = "Authorization: Bearer %s"\n' "$(tr -d '[:space:]' <"$root/gateway-token")" |
  ug_as "$agent_user" curl -K - -sS -w $'\n%{http_code}' --max-time 10 "$models_url" 2>/dev/null) ) || true
models_code=${models##*$'\n'}
models_list=${models%$'\n'*}
[[ -n $models_code ]] || models_code="did not answer"
[[ $models_code == 200 ]] ||
  ug_die ug-agent-setup "$models_url answered $models_code with the bearer in $root/gateway-token; the agent cannot call the gateway"
[[ $models_list == *'"id":'* ]] ||
  ug_die ug-agent-setup "$models_url lists no model; the agent has nothing to call"
ug_say ok "gateway auth" "401 without a bearer, 200 with it, models listed"

usage_url=http://127.0.0.1:${usage_broker_port}/v1/usage
usage_code=$(agent_http "$usage_url")
if [[ $usage_code == 200 ]]; then
  ug_say ok "usage broker" "answers 200"
else
  ug_say warn "usage broker" "$usage_url answered $usage_code; setup continues"
fi

model_start=$(date +%s)
model_rc=0
model_out=$( (cd / && ug_as "$agent_user" /bin/sh -c '
  set -m
  "$1" -p "Reply with: ok" </dev/null & child=$!
  ( i=$2
    while [ "$i" -gt 0 ]; do
      kill -0 "$child" 2>/dev/null || exit 0
      sleep 1
      i=$(( i - 1 ))
    done
    kill -TERM -- "-$child" 2>/dev/null
    sleep 5
    kill -KILL -- "-$child" 2>/dev/null ) >/dev/null 2>&1 &
  wait "$child" 2>/dev/null
  exit $?
' sh "$code/agent-start" 60 2>&1) ) || model_rc=$?
model_elapsed=$(( $(date +%s) - model_start ))
model_cut=""
[[ $model_elapsed -lt 60 ]] || model_cut=", cut off at the 60 s limit"
model_note=${model_out//$'\n'/ }
model_note=${model_note:0:200}
if [[ $model_rc -eq 0 ]]; then
  ug_say ok "model call" "answered in ${model_elapsed}s: ${model_note:-no output}"
else
  ug_say warn "model call" "$code/agent-start exited $model_rc after ${model_elapsed}s$model_cut: ${model_note:-no output}; setup continues"
fi
