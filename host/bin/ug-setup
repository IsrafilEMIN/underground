#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-setup\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
# shellcheck source=host/lib/backup-target.bash disable=SC1091
source "$src/host/lib/backup-target.bash"
data="$HOME/$(ug_fact owner_data)"
real=$(cd "$data" 2>/dev/null && pwd -P) || real=$data
case $src/ in
  "$data/"* | "$real/"*)
    printf 'ug-setup: %s is inside %s, which setup itself writes; run setup from your own checkout\n' "$src" "$data" >&2
    exit 64
    ;;
esac
green=$(ug_paint 1 green) yellow=$(ug_paint 1 yellow) plain=$(ug_paint 1 off)

bin_dir="$HOME/.local/bin"
root=$(ug_fact root)
agents_dir="$HOME/Library/LaunchAgents"
addresses_file="$data/addresses"

trap 'ug_stopped $? $LINENO "$BASH_COMMAND" ug-setup host/bin/ug-setup' ERR

later=()

if [[ ${UG_SETUP_PULLED:-} != 1 ]]; then
  ug_pull_main "$src" ug-setup || exit 1
  UG_SETUP_PULLED=1 exec "$BASH" "$src/host/bin/ug-setup"
fi
ug_check_checkout "$src" ug-setup || exit 1
pin() {
  local value
  value=$(ug_pin "$src/VERSIONS" "$1")
  [[ $value =~ $2 ]] || ug_die ug-setup "bad pin for $1 in VERSIONS"
  printf '%s\n' "$value"
}

omp_pin=$(pin omp '^[0-9A-Za-z.+-]+$')
omp_sha=$(pin omp_sha256 '^[0-9a-f]{64}$')
omp_release=$(pin omp_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$')
restic_pin=$(pin restic '^[0-9A-Za-z.+-]+$')
restic_bz2_sha=$(pin restic_bz2_sha256 '^[0-9a-f]{64}$')
restic_release=$(pin restic_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$')
gh_pin=$(pin gh '^[0-9A-Za-z.+-]+$')
gh_zip_sha=$(pin gh_zip_sha256 '^[0-9a-f]{64}$')
gh_release=$(pin gh_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$')

[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] || ug_die ug-setup "the omp pin names omp-darwin-arm64; this mac is $(uname -s) $(uname -m)"
for name in omp ug-auth; do
  [[ ! -e $bin_dir/$name || -L $bin_dir/$name ]] || ug_die ug-setup "$bin_dir/$name is a file, not setup's link; move it away, then run setup again"
done

cleanup=()
trap '[[ ${#cleanup[@]} -eq 0 ]] || rm -rf "${cleanup[@]}"' EXIT

omp_stage=""
stage_omp() {
  local dest="$root/omp/$omp_pin/omp" have url
  if [[ -f $dest && $(ug_sha256 "$dest") == "$omp_sha" ]]; then
    ug_say same "omp $omp_pin" "in place in $dest"
    return 0
  fi
  url="$omp_release/v$omp_pin/omp-darwin-arm64"
  omp_stage=$(mktemp "${TMPDIR:-/tmp}/ug-omp-download.XXXXXX")
  cleanup+=("$omp_stage")
  curl -fsSL --proto '=https' --retry 3 -o "$omp_stage" "$url" || ug_die ug-setup "download of $url failed"
  have=$(ug_sha256 "$omp_stage")
  [[ $have == "$omp_sha" ]] || ug_die ug-setup "omp $omp_pin from $url has SHA-256 $have, want $omp_sha; nothing changed"
  ug_say changed "omp $omp_pin" "downloaded and checked; the root step installs it in $dest"
}

stage_omp
install -d -m 700 "$data" "$data/restic" "$data/gh"
[[ -d $bin_dir ]] || install -d -m 755 "$bin_dir"

install_restic() {
  local dir="$data/restic/$restic_pin" dest tmp bin have url
  dest="$dir/restic"
  if [[ -f $dest && ! -L $dest ]]; then
    ug_say same "restic $restic_pin" "in place"
    return 0
  fi
  url="$restic_release/v$restic_pin/restic_${restic_pin}_darwin_arm64.bz2"
  tmp=$(mktemp "$data/restic/.download.XXXXXX")
  bin=$(mktemp "$data/restic/.binary.XXXXXX")
  cleanup+=("$tmp" "$bin")
  curl -fsSL --proto '=https' --retry 3 -o "$tmp" "$url" || ug_die ug-setup "download of $url failed"
  have=$(ug_sha256 "$tmp")
  [[ $have == "$restic_bz2_sha" ]] || ug_die ug-setup "restic $restic_pin from $url has SHA-256 $have, want $restic_bz2_sha; nothing changed"
  bunzip2 -c "$tmp" >"$bin" || ug_die ug-setup "bunzip2 of $url failed; nothing changed"
  chmod 555 "$bin"
  install -d -m 700 "$dir"
  mv -f "$bin" "$dest"
  ug_say changed "restic $restic_pin" "installed in $dest"
}

stage_gh() {
  local dir="$data/gh/$gh_pin" dest tmp have url old
  dest="$dir/gh.zip"
  if [[ -f $dest && ! -L $dest && $(ug_sha256 "$dest") == "$gh_zip_sha" ]]; then
    ug_say same "gh $gh_pin" "in place in $dest"
  else
    url="$gh_release/v$gh_pin/gh_${gh_pin}_macOS_arm64.zip"
    tmp=$(mktemp "$data/gh/.download.XXXXXX")
    cleanup+=("$tmp")
    curl -fsSL --proto '=https' --retry 3 -o "$tmp" "$url" || ug_die ug-setup "download of $url failed"
    have=$(ug_sha256 "$tmp")
    [[ $have == "$gh_zip_sha" ]] || ug_die ug-setup "gh $gh_pin from $url has SHA-256 $have, want $gh_zip_sha; nothing changed"
    install -d -m 700 "$dir"
    mv -f "$tmp" "$dest"
    ug_say changed "gh $gh_pin" "downloaded and checked; the root step checks it again and installs it for the agent"
  fi
  for old in "$data"/gh/*; do
    [[ $old == "$dir" ]] || rm -rf "$old"
  done
}

setup_backup() {
  local backup="$data/backup"
  local fix="write $backup/config with a repo=sftp:<user>@<host>:<path> line, plus optional wake=<command> and sleep=<command> lines; wake runs when the host does not answer ssh, sleep after each backup; until then, no backup runs"
  local err='' answer='' wake_in='' sleep_in='' tmp restic_bin status=0 out
  install -d -m 700 "$backup"
  if [[ ! -s $backup/password ]]; then
    (umask 077 && openssl rand -base64 32 >"$backup/password") || ug_die ug-setup "cannot write $backup/password"
    ug_say changed backup "made the password $backup/password"
    later+=("keep a copy of $backup/password in your password manager; without it, the backup cannot be opened after a loss of this mac")
  fi
  if [[ ! -f $backup/config ]] || ! err=$(backup_target_read "$backup/config" 2>&1 >/dev/null); then
    [[ -z $err ]] || ug_say ok backup "${err//$'\n'/ }"
    if [[ -t 0 ]]; then
      read -r -p "backup repository address, as sftp:<user>@<host>:<path>, empty for none: " answer || answer=''
      if [[ -n $answer ]]; then
        read -r -p "command to wake the backup host when it does not answer ssh, empty for none: " wake_in || wake_in=''
        read -r -p "command to put the backup host back to sleep after a backup, empty for none: " sleep_in || sleep_in=''
        tmp=$(mktemp "$backup/.config.XXXXXX")
        cleanup+=("$tmp")
        {
          printf 'repo=%s\n' "$answer"
          [[ -z $wake_in ]] || printf 'wake=%s\n' "$wake_in"
          [[ -z $sleep_in ]] || printf 'sleep=%s\n' "$sleep_in"
        } >"$tmp"
        if err=$(backup_target_read "$tmp" 2>&1 >/dev/null); then
          put "$tmp" "$backup/config" 600
          ug_say changed backup "wrote $backup/config with $answer"
        else
          ug_say ok backup "those answers are not a valid config: ${err//$'\n'/ }; nothing was written"
          later+=("$fix")
        fi
      else
        later+=("$fix")
      fi
    else
      later+=("$fix")
    fi
  fi
  backup_target_read "$backup/config" >/dev/null 2>&1 || return 0
  if ! backup_target_up; then
    ug_say ok backup "$target does not answer ssh, or the ssh key does not work without a prompt; run ssh-keygen -t ed25519, then ssh-copy-id $target"
    return 0
  fi
  restic_bin="$data/restic/$restic_pin/restic"
  out=$(RESTIC_PASSWORD_FILE="$backup/password" "$restic_bin" -r "$repo" cat config 2>&1 >/dev/null) || status=$?
  case $status in
    0) ug_say ok backup "$repo is reachable and the backup password opens it" ;;
    10) ug_say ok backup "$repo is reachable but holds no repository yet; ug-backup creates it on its first run" ;;
    12) ug_say ok backup "$repo does not open with $backup/password; the backup password is not the one the repository was created with" ;;
    *) ug_say ok backup "restic could not check $repo (exit $status): ${out//$'\n'/ }" ;;
  esac
}

check_source() {
  local path=$1 up rname bref remote dirty
  up=$(git -C "$path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || up=
  [[ -n $up ]] || { ug_say ok "source $path" "has no upstream branch; setup did not update it"; return 0; }
  rname=${up%/*}
  bref=${up#*/}
  remote=$(GIT_TERMINAL_PROMPT=0 git -C "$path" ls-remote "$rname" "refs/heads/$bref" 2>/dev/null | cut -f1) || remote=
  [[ -n $remote ]] || { ug_say ok "source $path" "cannot read $up from origin; check the network, setup did not update it"; return 0; }
  if git -C "$path" cat-file -e "$remote^{commit}" 2>/dev/null && git -C "$path" merge-base --is-ancestor "$remote" HEAD; then
    ug_say same "source $path" "already has $up"
    return 0
  fi
  dirty=$(git -C "$path" status --porcelain 2>/dev/null) || dirty=unknown
  [[ -z $dirty ]] || { ug_say ok "source $path" "has uncommitted changes; setup did not update it"; return 0; }
  if GIT_TERMINAL_PROMPT=0 git -C "$path" pull --quiet --ff-only 2>/dev/null; then
    ug_say changed "source $path" "fast-forwarded to $up"
  else
    ug_say ok "source $path" "$up cannot fast-forward onto its origin; setup did not update it"
  fi
}

expand_home() {
  case $1 in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s\n' "$HOME/${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

setup_sources() {
  local line path target
  if [[ ! -f $data/sources ]]; then
    if [[ -t 0 ]]; then
      read -r -p "path of the config repo to sync into the agent, empty for none: " path || path=''
      path=$(expand_home "$path")
      if [[ -n $path ]]; then
        read -r -p "target inside the agent home [.omp/agent]: " target || target=''
        [[ -n $target ]] || target=.omp/agent
        printf '%s %s\n' "$path" "$target" >"$data/sources"
        ug_say changed sources "wrote $data/sources with $path $target"
      else
        : >"$data/sources"
        ug_say changed sources "wrote an empty $data/sources; add one line per config repo to sync"
      fi
    else
      : >"$data/sources"
      ug_say ok sources "wrote an empty $data/sources; add one line per config repo to sync"
    fi
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -n $line && $line != '#'* ]] || continue
    read -r path target <<<"$line"
    [[ -n $path && $path != plugin && -n $target ]] || continue
    path=$(expand_home "$path")
    [[ -d $path/.git ]] || { ug_say ok "source $path" "is not a git repository; setup did not update it"; continue; }
    check_source "$path"
  done <"$data/sources"
  [[ -s $data/sources ]] ||
    later+=("write $data/sources with one line per config repo to sync into the agent, as <local repo path> <target inside the agent home>, for example ~/Developer/Projects/agent-config .omp/agent; ~ is your home, blank lines and lines that start with # are skipped; until then, omp does not update the agent's config")
}

put() {
  local from=$1 to=$2 mode=$3 tmp
  tmp=$(mktemp "$(dirname "$to")/.put.XXXXXX")
  cleanup+=("$tmp")
  cat "$from" >"$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$to"
}

link() {
  local target=$1 at=$2
  rm -f "$at"
  ln -s "$target" "$at"
}

retire_agents() {
  local plist label err keep
  keep=$(ug_services agent | cut -d '|' -f 1)
  for plist in "$agents_dir"/com.underground.*.plist; do
    [[ -e $plist || -L $plist ]] || continue
    label=${plist##*/}
    label=${label%.plist}
    grep -qxF "$label" <<<"$keep" && continue
    err=$(ug_stop_service "gui/$UID/$label") || ug_die ug-setup "$err"
    rm -f "$plist"
    ug_say changed "service $label" "booted out and deleted; this version of underground does not run it"
  done
}

install_service_code() {
  local dir="$data/services" f
  rm -rf "$dir"
  install -d -m 700 "$dir" "$dir/host/bin" "$dir/host/lib"
  for f in host/bin/ug-backup host/bin/ug-auth host/lib/backup-target.bash host/lib/ug.bash host/facts host/services VERSIONS; do
    put "$src/$f" "$dir/$f" 444
  done
  chmod 555 "$dir/host/bin/ug-backup" "$dir/host/bin/ug-auth"
  link "$dir/host/bin/ug-auth" "$bin_dir/ug-auth"
  ug_say ok services "code installed in $dir, ug-auth on PATH as $bin_dir/ug-auth"
}

write_addresses() {
  local engine tmp
  local fix="write $addresses_file with one engine=<ip>:<port> line naming the inference engine"
  engine=$(sed -n 's/^engine=//p' "$addresses_file" 2>/dev/null | head -1) || true
  if [[ $engine =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$ ]]; then
    ug_say same addresses "$addresses_file holds engine=$engine"
    return 0
  fi
  [[ -t 0 ]] || ug_die ug-setup "no $addresses_file with an engine=<ip>:<port> line, and no terminal to ask for the engine address; $fix"
  read -r -p "engine address of the inference engine, as <ip>:<port>: " engine || engine=''
  [[ $engine =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$ ]] || ug_die ug-setup "the engine address '$engine' is not <ip>:<port>; nothing was written. Run setup again, or $fix"
  tmp=$(mktemp "$addresses_file.XXXXXX")
  cleanup+=("$tmp")
  printf 'engine=%s\n' "$engine" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$addresses_file"
  ug_say changed addresses "wrote $addresses_file with engine=$engine"
}

prepare_services() {
  write_addresses
}

# shellcheck disable=SC2154
start_services() {
  local label name scope user template health log rendered out
  install -d "$agents_dir"
  while IFS='|' read -r label name scope user template health log; do
    rendered=$(mktemp "$agents_dir/.$label.XXXXXX")
    cleanup+=("$rendered")
    out=$(ug_render "$rendered" "$src/$template" "$template" -e "s|@DATA@|$data|g") || ug_die ug-setup "$out"
    ug_service_probe agent "$label" "$health" || ug_die ug-setup "setup cannot check $label; nothing changed for it"
    out=$(ug_ensure_service "gui/$UID" "$label" "$rendered" "$agents_dir/$label.plist" "${ug_probe[@]}") ||
      ug_die ug-setup "$out; read $(ug_service_expand "$log")"
    ug_say ok "$ug_probe_subject" "$out"
  done < <(ug_services agent)
}

check_path() {
  local dirs dir found=()
  IFS=: read -r -a dirs <<<"$PATH"
  for dir in "${dirs[@]}"; do
    [[ -n $dir && -x $dir/omp && ! -d $dir/omp ]] && found+=("$dir/omp")
  done
  if [[ ${#found[@]} -eq 0 ]]; then
    later+=("no omp is on PATH; put $bin_dir on PATH, so that omp starts the agent")
  elif [[ ${found[0]} != "$bin_dir/omp" ]]; then
    later+=("the first omp on PATH is ${found[0]}, not the agent launcher $bin_dir/omp; put $bin_dir on PATH before ${found[0]%/omp}")
  elif [[ ${#found[@]} -gt 1 ]]; then
    later+=("more than one omp is on PATH: ${found[*]}; remove all but $bin_dir/omp")
  fi
}

finish() {
  if [[ ${#later[@]} -eq 0 ]]; then
    printf '%sug-setup: done; nothing is left to do%s\n' "$green" "$plain"
    return 0
  fi
  printf '%sug-setup: done.%s %sstill to do:%s\n' "$green" "$plain" "$yellow" "$plain"
  local item
  for item in "${later[@]}"; do
    printf '  %s-%s %s\n' "$yellow" "$plain" "$item"
  done
}

install_restic
stage_gh
retire_agents
install_service_code
setup_backup
setup_sources
prepare_services
ug_say ok "agent user" "running sudo host/bin/ug-agent-setup, which asks for your password"
no_color=()
[[ -z ${NO_COLOR:-} ]] || no_color=(env NO_COLOR=1)
sudo ${no_color[@]+"${no_color[@]}"} "$src/host/bin/ug-agent-setup" ${omp_stage:+"$omp_stage"} || ug_die ug-setup "ug-agent-setup failed, so the agent user is not up to date; fix its error and run host/bin/ug-setup again"
start_services
check_path
finish
