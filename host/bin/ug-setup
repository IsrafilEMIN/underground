#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 0 ]]; then
  printf 'usage: ug-setup\n' >&2
  exit 64
fi

src=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
# shellcheck source=host/lib/ug.bash disable=SC1091
source "$src/host/lib/ug.bash"
# shellcheck source=host/lib/downloads.bash disable=SC1091
source "$src/host/lib/downloads.bash"
# shellcheck source=host/lib/services.bash disable=SC1091
source "$src/host/lib/services.bash"
# shellcheck source=host/lib/github.bash disable=SC1091
source "$src/host/lib/github.bash"
# shellcheck source=host/lib/sources.bash disable=SC1091
source "$src/host/lib/sources.bash"
# shellcheck source=host/lib/backup-target.bash disable=SC1091
source "$src/host/lib/backup-target.bash"
data="$HOME/$(ug_fact owner_data)"
real=$(cd "$data" 2>/dev/null && pwd -P) || real=$data
case $src/ in
  "$data/"* | "$real/"*)
    printf 'ug-setup: %s is inside %s, which setup itself writes; run setup from your own checkout\n' "$src" "$data" >&2
    exit 64
    ;;
esac

bin_dir="$HOME/.local/bin"
agents_dir="$HOME/Library/LaunchAgents"
addresses_file="$data/addresses"

trap 'ug_stopped $? $LINENO "$BASH_COMMAND" ug-setup host/bin/ug-setup' ERR

later=()

if [[ ${UG_SETUP_PULLED:-} != 1 ]]; then
  ug_step checkout
  ug_pull_main "$src" ug-setup || exit 1
  UG_SETUP_PULLED=1 exec "$BASH" "$src/host/bin/ug-setup"
fi
ug_check_checkout "$src" ug-setup || exit 1
restic_pin=$(ug_pin_checked "$src/VERSIONS" restic '^[0-9A-Za-z.+-]+$' ug-setup)
restic_bz2_sha=$(ug_pin_checked "$src/VERSIONS" restic_bz2_sha256 '^[0-9a-f]{64}$' ug-setup)
restic_release=$(ug_pin_checked "$src/VERSIONS" restic_release '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download$' ug-setup)

[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] || ug_die ug-setup "the omp pin names omp-darwin-arm64; this mac is $(uname -s) $(uname -m)"
[[ ! -e $bin_dir/ug-auth || -L $bin_dir/ug-auth ]] || ug_die ug-setup "$bin_dir/ug-auth is a file, not setup's link; move it away, then run setup again"

cleanup=()
trap '[[ ${#cleanup[@]} -eq 0 ]] || rm -rf "${cleanup[@]}"' EXIT

ug_step tools
install -d -m 700 "$data" "$data/restic"
[[ -d $bin_dir ]] || install -d -m 755 "$bin_dir"

install_restic() {
  local dir="$data/restic/$restic_pin" archive dest bin url
  url="$restic_release/v$restic_pin/restic_${restic_pin}_darwin_arm64.bz2"
  archive="$dir/restic.bz2"
  ug_fetch_pinned "$url" "$restic_bz2_sha" "$archive" ug-setup || exit 1
  dest="$dir/restic"
  bin=$(mktemp "$dir/.binary.XXXXXX")
  cleanup+=("$bin")
  bunzip2 -c "$archive" >"$bin" || ug_die ug-setup "bunzip2 of $url failed; nothing changed"
  chmod 555 "$bin"
  mv -f "$bin" "$dest"
  ug_say ok restic "$restic_pin ready"
}

setup_backup() {
  local backup="$data/backup"
  local fix="write $backup/config: repo=sftp:<user>@<host>:<path>, optional wake=<cmd> and sleep=<cmd>; no backup runs until then"
  local err='' answer='' wake_in='' sleep_in='' tmp restic_bin status=0 out
  install -d -m 700 "$backup"
  if [[ ! -s $backup/password ]]; then
    (umask 077 && openssl rand -base64 32 >"$backup/password") || ug_die ug-setup "cannot write $backup/password"
    ug_say changed "backup password" "created $backup/password"
    later+=("save $backup/password in your password manager; without it, a lost mac means a lost backup")
  fi
  if [[ ! -f $backup/config ]] || ! err=$(backup_target_read "$backup/config" 2>&1 >/dev/null); then
    [[ -z $err ]] || ug_say warn backup "${err//$'\n'/ }"
    if [[ -t 0 ]]; then
      read -r -p "  ? backup repository (sftp:user@host:path, empty for none): " answer || answer=''
      if [[ -n $answer ]]; then
        read -r -p "  ? command to wake the backup host (empty for none): " wake_in || wake_in=''
        read -r -p "  ? command to put it back to sleep (empty for none): " sleep_in || sleep_in=''
        tmp=$(mktemp "$backup/.config.XXXXXX")
        cleanup+=("$tmp")
        {
          printf 'repo=%s\n' "$answer"
          [[ -z $wake_in ]] || printf 'wake=%s\n' "$wake_in"
          [[ -z $sleep_in ]] || printf 'sleep=%s\n' "$sleep_in"
        } >"$tmp"
        if err=$(backup_target_read "$tmp" 2>&1 >/dev/null); then
          put "$tmp" "$backup/config" 600
          ug_say changed backup "wrote $backup/config ($answer)"
        else
          ug_say warn backup "invalid answers, nothing written: ${err//$'\n'/ }"
          later+=("$fix")
        fi
      else
        later+=("$fix")
      fi
    else
      later+=("$fix")
    fi
  fi
  backup_target_read "$backup/config" >/dev/null 2>&1 || return 0
  if ! backup_target_up; then
    ug_say warn backup "$target does not answer ssh without a prompt; run ssh-keygen -t ed25519, then ssh-copy-id $target"
    return 0
  fi
  restic_bin="$data/restic/$restic_pin/restic"
  out=$(RESTIC_PASSWORD_FILE="$backup/password" "$restic_bin" -r "$repo" cat config 2>&1 >/dev/null) || status=$?
  case $status in
    0) ug_say ok backup "$repo opens with the password" ;;
    10) ug_say ok backup "$repo is empty; ug-backup creates it on its first run" ;;
    12) ug_say warn backup "$repo does not open with $backup/password; wrong password" ;;
    *) ug_say warn backup "restic cannot check $repo (exit $status): ${out//$'\n'/ }" ;;
  esac
}

check_source() {
  local path=$1 up rname bref remote dirty
  up=$(git -C "$path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || up=
  [[ -n $up ]] || { ug_say warn source "$path has no upstream branch; not updated"; return 0; }
  rname=${up%/*}
  bref=${up#*/}
  remote=$(GIT_TERMINAL_PROMPT=0 git -C "$path" ls-remote "$rname" "refs/heads/$bref" 2>/dev/null | cut -f1) || remote=
  [[ -n $remote ]] || { ug_say warn source "$path: cannot read $up from origin; check the network; not updated"; return 0; }
  if git -C "$path" cat-file -e "$remote^{commit}" 2>/dev/null && git -C "$path" merge-base --is-ancestor "$remote" HEAD; then
    ug_say same source "$path up to date"
    return 0
  fi
  dirty=$(git -C "$path" status --porcelain 2>/dev/null) || dirty=unknown
  [[ -z $dirty ]] || { ug_say warn source "$path has uncommitted changes; not updated"; return 0; }
  if GIT_TERMINAL_PROMPT=0 git -C "$path" pull --quiet --ff-only 2>/dev/null; then
    ug_say changed source "$path fast-forwarded to $up"
  else
    ug_say warn source "$path cannot fast-forward to $up; not updated"
  fi
}

setup_sources() {
  local pairs path target
  if [[ ! -f $data/sources ]]; then
    if [[ -t 0 ]]; then
      read -r -p "  ? config repo to sync into the agent (empty for none): " path || path=''
      path=$(ug_expand_home "$path" "$HOME")
      if [[ -n $path ]]; then
        read -r -p "  ? target in the agent home (.omp/agent): " target || target=''
        [[ -n $target ]] || target=.omp/agent
        printf '%s %s\n' "$path" "$target" >"$data/sources"
        ug_say changed sources "wrote $data/sources ($path $target)"
      else
        : >"$data/sources"
        ug_say changed sources "wrote an empty $data/sources"
      fi
    else
      : >"$data/sources"
      ug_say changed sources "wrote an empty $data/sources"
    fi
  fi
  pairs=$(ug_read_sources "$data/sources" "$HOME" ug-setup) ||
    ug_die ug-setup "fix $data/sources and run host/bin/ug-setup again"
  while IFS=$'\t' read -r path target; do
    [[ -n $path ]] || continue
    [[ -d $path/.git ]] || { ug_say warn source "$path is not a git repository; not updated"; continue; }
    check_source "$path"
  done <<<"$pairs"
  [[ -s $data/sources ]] ||
    later+=("add config repos to $data/sources, one per line: <repo path> <target in the agent home>, for example ~/Developer/Projects/agent-config .omp/agent; until then, nothing updates the agent's config")
}

put() {
  local from=$1 to=$2 mode=$3 tmp
  tmp=$(mktemp "$(dirname "$to")/.put.XXXXXX")
  cleanup+=("$tmp")
  cat "$from" >"$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$to"
}

link() {
  local target=$1 at=$2
  rm -f "$at"
  ln -s "$target" "$at"
}

retire_agents() {
  local plist label err keep
  keep=$(ug_services agent | cut -d '|' -f 1)
  for plist in "$agents_dir"/com.underground.*.plist; do
    [[ -e $plist || -L $plist ]] || continue
    label=${plist##*/}
    label=${label%.plist}
    grep -qxF "$label" <<<"$keep" && continue
    err=$(ug_stop_service "gui/$UID/$label") || ug_die ug-setup "$err"
    rm -f "$plist"
    ug_say changed "${label#com.underground.}" "retired: booted out, plist deleted"
  done
}

install_service_code() {
  local dir="$data/services" f
  rm -rf "$dir"
  install -d -m 700 "$dir" "$dir/host/bin" "$dir/host/lib"
  for f in host/bin/ug-backup host/bin/ug-auth host/bin/ug-sync host/lib/backup-target.bash host/lib/sources.bash host/lib/ug.bash host/facts host/services VERSIONS; do
    put "$src/$f" "$dir/$f" 444
  done
  chmod 555 "$dir/host/bin/ug-backup" "$dir/host/bin/ug-auth" "$dir/host/bin/ug-sync"
  link "$dir/host/bin/ug-auth" "$bin_dir/ug-auth"
  ug_say ok "service code" "installed in $dir, ug-auth in $bin_dir"
}

write_addresses() {
  local engine tmp
  local fix="write $addresses_file with one engine=<ip>:<port> line naming the inference engine"
  engine=$(sed -n 's/^engine=//p' "$addresses_file" 2>/dev/null | head -1) || true
  if [[ $engine =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$ ]]; then
    ug_say same engine "$engine"
    return 0
  fi
  [[ -t 0 ]] || ug_die ug-setup "no $addresses_file with an engine=<ip>:<port> line, and no terminal to ask for the engine address; $fix"
  read -r -p "  ? inference engine address (ip:port): " engine || engine=''
  [[ $engine =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{1,5}$ ]] || ug_die ug-setup "the engine address '$engine' is not <ip>:<port>; nothing was written. Run setup again, or $fix"
  tmp=$(mktemp "$addresses_file.XXXXXX")
  cleanup+=("$tmp")
  printf 'engine=%s\n' "$engine" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$addresses_file"
  ug_say changed engine "wrote $engine to $addresses_file"
}

prepare_services() {
  write_addresses
}

# shellcheck disable=SC2154
start_services() {
  local label name scope user template health log watch rendered out kind
  install -d "$agents_dir"
  while IFS='|' read -r label name scope user template health log watch; do
    rendered=$(mktemp "$agents_dir/.$label.XXXXXX")
    cleanup+=("$rendered")
    out=$(ug_render "$rendered" "$src/$template" "$template" -e "s|@DATA@|$data|g") || ug_die ug-setup "$out"
    ug_service_probe agent "$label" "$health" || ug_die ug-setup "setup cannot check $label; nothing changed for it"
    watch=$(ug_service_expand "$watch") || ug_die ug-setup "cannot expand the code paths of $label"
    out=$(ug_ensure_service "gui/$UID" "$label" "$rendered" "$agents_dir/$label.plist" "$watch" "${ug_probe[@]}") ||
      ug_die ug-setup "$out; read $(ug_service_expand "$log")"
    kind=changed
    [[ $out != unchanged* ]] || kind=same
    ug_say "$kind" "$name" "$out"
  done < <(ug_services agent)
}

sync_sources() {
  local out
  if out=$("$data/services/host/bin/ug-sync" 2>&1); then
    ug_say ok sources "synced $data/sources into the agent home"
  else
    ug_say warn sources "ug-sync failed: ${out//$'\n'/ }"
  fi
}

setup_tern() {
  local tern=/Applications/Tern.app/Contents/MacOS/tern agent_user agent_home port line addr='' fp='' extra='' out how ts_ip host
  agent_user=$(ug_fact agent_user)
  agent_home=$(ug_fact agent_home)
  port=$(ug_fact agent_tern_port)
  ug_step tern
  line=$(cat "$data/tern-host" 2>/dev/null) || line=
  read -r addr fp extra <<<"$line" || true
  if [[ $addr =~ ^127\.0\.0\.1:[0-9]{1,5}$ && $fp =~ ^SHA256:[A-Za-z0-9+/]+=*$ && -z $extra ]]; then
    port=${addr#*:}
  else
    ug_say warn tern "$data/tern-host is missing or is not one line of 127.0.0.1:<port> SHA256:<fingerprint>; run host/bin/ug-setup again"
    fp=''
  fi
  # The mac and the phone both reach the mac's Tailscale address, so one host works on every Tern device.
  ts_ip=$(ifconfig | awk '$1 == "inet" && $2 ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./ { print $2; exit }')
  host=${ts_ip:-127.0.0.1}:$port
  [[ -n $ts_ip ]] || ug_say warn tern "this mac has no Tailscale address, so only this mac reaches the agent's Tern host at $host; turn on Tailscale, then run host/bin/ug-setup again"
  if [[ -z $fp ]]; then
    how="setup cannot read its host key from $data/tern-host, so run host/bin/ug-setup again and trust the key it reports"
  elif [[ ! -x $tern ]]; then
    ug_say warn tern "$tern is missing; install Tern in /Applications"
    how="its host key is not trusted yet; install Tern in /Applications, then run: $tern remote trust $host $fp"
  elif out=$("$tern" remote trust "$host" "$fp" 2>&1); then
    ug_say ok tern "trusted the agent host key $fp for $host"
    how="its host key $fp is already trusted on this mac; on the phone, check that it is $fp"
  else
    ug_say warn tern "tern remote trust $host $fp failed: ${out//$'\n'/ }"
    how="its host key is not trusted yet; run: $tern remote trust $host $fp"
  fi
  later+=("open Tern, choose Add remote host, and enter $agent_user@$host (replace an older $agent_user@127.0.0.1:$port host); $how. typing omp in that shell starts the agent in the current folder; repos live in $agent_home/work/<owner>/<name> there; the agent accepts the phone keys in host/tern-keys")
  compgen -G "$HOME/.ssh/id_*.pub" >/dev/null ||
    later+=("you have no ssh key in $HOME/.ssh, so Tern cannot log in to the agent; run ssh-keygen -t ed25519, then run host/bin/ug-setup again")
}

check_app_repos() {
  local slug repo private login out
  [[ -f $data/app-repos ]] || return 0
  ug_step "app repos"
  login=$(gh api user | jq -r '.login // empty') || login=""
  [[ -n $login ]] || { ug_say warn "app repos" "gh is not logged in, so setup cannot check main rules; run gh auth login, then setup again"; return 0; }
  slug=$(ug_repo_slug "$src") || slug=""
  while read -r repo private || [[ -n $repo ]]; do
    [[ -n $repo && $repo != "$slug" ]] || continue
    if [[ $private == true ]]; then
      later+=("$repo is private, so a free GitHub plan does not enforce its main rule and the agent could change main: make it public, upgrade the plan, or remove it from the app")
      continue
    fi
    if out=$(ug_check_repo_rule "$repo" "$login" 2>&1); then
      ug_say same "main rule" "$repo needs @$login approval"
    else
      later+=("${out//$'\n'/ }")
    fi
  done <"$data/app-repos"
}

check_agent() {
  local root agent_user out line
  root=$(ug_fact root)
  agent_user=$(ug_fact agent_user)
  ug_step "agent check"
  if ! out=$( (cd / && sudo -n -u "$agent_user" -H "$root/code/bin/agent-check" "$root/code/requirements") 2>/dev/null); then
    ug_say warn "agent check" "sudo cannot run $root/code/bin/agent-check as $agent_user; run host/bin/ug-setup again"
    return 0
  fi
  if [[ -z $out ]]; then
    ug_say ok "agent check" "every requirement is met"
    return 0
  fi
  while IFS= read -r line; do
    [[ -z $line ]] || ug_say warn "agent check" "$line"
  done <<<"$out"
}

finish() {
  local item n=0
  printf '\n%s%s✓ setup done%s\n' "$(ug_paint 1 bold)" "$(ug_paint 1 green)" "$(ug_paint 1 off)"
  [[ ${#later[@]} -gt 0 ]] || return 0
  printf '\n%s%sto do%s\n' "$(ug_paint 1 bold)" "$(ug_paint 1 yellow)" "$(ug_paint 1 off)"
  for item in "${later[@]}"; do
    n=$((n + 1))
    printf '  %d. %s\n' "$n" "$(ug_short "$item")"
  done
}

install_restic
retire_agents
install_service_code

ug_step backup
setup_backup

ug_step sources
setup_sources

ug_step engine
prepare_services

ug_step "agent user"
ug_say ok sudo "running host/bin/ug-agent-setup; it may ask for your password"
no_color=()
[[ -z ${NO_COLOR:-} ]] || no_color=(env NO_COLOR=1)
sudo ${no_color[@]+"${no_color[@]}"} "$src/host/bin/ug-agent-setup" || ug_die ug-setup "ug-agent-setup failed, so the agent user is not up to date; fix its error and run host/bin/ug-setup again"
sync_sources

check_app_repos

ug_step services
start_services
check_agent
setup_tern
finish
