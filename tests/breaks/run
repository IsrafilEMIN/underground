#!/bin/bash
BREAKS_DIR=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
TESTS_DIR=${BREAKS_DIR%/*}
ROOT=$(cd "$TESTS_DIR/.." && pwd)
# shellcheck source=tests/lib.bash
source "$TESTS_DIR/lib.bash" || { printf 'breaks: cannot read %s/lib.bash\n' "$TESTS_DIR" >&2; exit 1; }
cd "$ROOT" || exit 1

ug_load_tests || { printf 'breaks: a test file cannot be read\n' >&2; exit 1; }
all_ids=$(ug_test_ids)

has_id() { [[ $'\n'"$all_ids"$'\n' == *$'\n'"$1"$'\n'* ]]; }

base=${TMPDIR:-/tmp}
base=${base%/}
works=()
new_work() {
  UG_WORK=$(mktemp -d "$base/underground-break.XXXXXX") || return 1
  works+=("$UG_WORK")
}
trap 'for d in ${works[@]+"${works[@]}"}; do rm -rf "$d"; done' EXIT

errors=0
fail_break() {
  printf 'breaks: %s\n%s\n' "$1" "$2" >&2
  errors=$((errors + 1))
}

clean=$(/bin/bash "$TESTS_DIR/run" 2>&1) ||
  { printf 'breaks: tests/run does not pass on the clean tree\n%s\n' "$clean" >&2; exit 1; }

ids=()
while IFS= read -r id; do
  [[ -n $id ]] && ids+=("$id")
done <<<"$all_ids"

for id in "${ids[@]}"; do
  [[ -f $BREAKS_DIR/$id.patch ]] ||
    { printf 'breaks: no break patch for %s\n' "$id" >&2; errors=$((errors + 1)); }
done
for patch in "$BREAKS_DIR"/*.patch; do
  [[ -f $patch ]] || continue
  id=${patch##*/}
  id=${id%.patch}
  has_id "$id" ||
    { printf 'breaks: patch %s has no test\n' "$id" >&2; errors=$((errors + 1)); }
done

for id in "${ids[@]}"; do
  patch=$BREAKS_DIR/$id.patch
  [[ -f $patch ]] || continue
  new_work || { fail_break "cannot make a work tree for $id" ''; continue; }
  tar -cf - -C "$ROOT" --exclude ./.git . | tar -xf - -C "$UG_WORK" ||
    { fail_break "cannot copy the tree for $id" ''; continue; }
  stale=$(cd "$UG_WORK" && git apply --check "$patch" 2>&1) ||
    { fail_break "stale patch $id" "$stale"; continue; }
  stale=$(cd "$UG_WORK" && git apply "$patch" 2>&1) ||
    { fail_break "stale patch $id" "$stale"; continue; }
  out=$(cd "$UG_WORK" && /bin/bash tests/run "$id" 2>&1)
  rc=$?
  if ((rc == 1)) && [[ $out == *"ASSERT-FAILED $id"* ]]; then
    printf 'caught %s\n' "$id"
  elif ((rc == 0)); then
    fail_break "break $id not caught" "$out"
  else
    fail_break "break $id did not fail on an assertion" "$out"
  fi
done

((errors)) && exit 1
exit 0
